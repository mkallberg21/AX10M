{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "composite": false,
    // Leaf app: disable incremental so a full emit always runs. With incremental on (inherited
    // from the base), tsc/nest-build skip emit when the .tsbuildinfo says inputs are unchanged —
    // even though nest's deleteOutDir already wiped dist — leaving dist empty (no dist/main.js).
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "types": ["node", "reflect-metadata"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
