{
  "name": "@ax10m/scheduler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./temporal": {
      "types": "./dist/temporal/index.d.ts",
      "default": "./dist/temporal/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rimraf dist *.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "test": "tsc -b && vitest run"
  },
  "dependencies": {
    "@ax10m/canonical": "workspace:*",
    "@ax10m/recovery-engine": "workspace:*",
    "@temporalio/activity": "^1.11.0",
    "@temporalio/client": "^1.11.0",
    "@temporalio/workflow": "^1.11.0"
  },
  "devDependencies": {
    "@temporalio/testing": "^1.11.0",
    "@temporalio/worker": "^1.11.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.0"
  }
}
