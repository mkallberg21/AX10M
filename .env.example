# ─────────────────────────────────────────────────────────────────────────────
# Lift — example environment. Copy to `.env` and fill with REAL values locally.
# This file contains PLACEHOLDERS ONLY. Never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=debug

# --- API (apps/api) ---
API_PORT=4000
API_HOST=0.0.0.0

# --- Stripe (POAL stripe adapter) ---
# Use a RESTRICTED key with least-privilege scopes (see ARCHITECTURE.md §7).
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_CONNECT_CLIENT_ID=ca_xxx
STRIPE_API_VERSION=2024-06-20

# --- Chargebee (POAL chargebee adapter — DRIVE) ---
# Use a RESTRICTED key. Webhook auth is HTTP Basic (configure the same user/pass
# in Chargebee's webhook settings). We hold only Chargebee tokens, never a PAN.
CHARGEBEE_SITE=your-site
CHARGEBEE_API_KEY=cb_test_xxx
CHARGEBEE_MERCHANT_ID=mrc_xxx
CHARGEBEE_WEBHOOK_USER=lift-webhook
CHARGEBEE_WEBHOOK_PASSWORD=change_me

# --- Postgres (append-only, hash-chained ledger + OLTP) ---
DATABASE_URL=postgresql://lift:lift@localhost:5432/lift

# --- Redis (online features / cache) ---
REDIS_URL=redis://localhost:6379

# --- Temporal (durable recovery saga — Phase 1) ---
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# --- Attribution engine ---
# Default control fraction for randomized holdout (0.10 = 10%).
LIFT_HOLDOUT_CONTROL_FRACTION=0.10
# Deterministic salt for holdout hashing. Rotate per environment; keep stable
# within an environment so assignment stays reproducible.
LIFT_HOLDOUT_SALT=change_me_stable_within_env
# Fee charged on the lower-bound verified uplift.
LIFT_FEE_RATE=0.12

# --- Dashboard (apps/dashboard) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# --- LLM (comms + analytics ONLY — never the charge decision path) ---
ANTHROPIC_API_KEY=sk-ant-xxx
