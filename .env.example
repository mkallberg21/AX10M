# ─────────────────────────────────────────────────────────────────────────────
# AX10M — example environment. Copy to `.env` and fill with REAL values locally.
# This file contains PLACEHOLDERS ONLY. Never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=debug

# --- API (apps/api) ---
API_PORT=4000
API_HOST=0.0.0.0

# --- Persistence (@ax10m/persistence) ---
# Set DATABASE_URL to use a real Postgres; if unset, a local pglite dir is used.
# DATABASE_URL=postgres://user:pass@localhost:5432/ax10m
AX10M_PGLITE_DIR=./.data/ax10m
# 64 hex chars (256-bit) for AES-256-GCM credential encryption at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER commit the real key. KMS/HSM-wrapped in production.
AX10M_ENCRYPTION_KEY=

# --- Stripe (POAL stripe adapter) ---
# Use a RESTRICTED key with least-privilege scopes (see ARCHITECTURE.md §7).
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_CONNECT_CLIENT_ID=ca_xxx
STRIPE_API_VERSION=2024-06-20
# AX10M-internal merchant id this Stripe account maps to (until per-Connect-account resolution).
STRIPE_MERCHANT_ID=mrc_demo

# --- Chargebee (POAL chargebee adapter — DRIVE) ---
# Use a RESTRICTED key. Webhook auth is HTTP Basic (configure the same user/pass
# in Chargebee's webhook settings). We hold only Chargebee tokens, never a PAN.
CHARGEBEE_SITE=your-site
CHARGEBEE_API_KEY=cb_test_xxx
CHARGEBEE_MERCHANT_ID=mrc_xxx
CHARGEBEE_WEBHOOK_USER=ax10m-webhook
CHARGEBEE_WEBHOOK_PASSWORD=change_me

# --- Adyen (POAL adyen adapter — DRIVE) ---
# Checkout API key + merchant account. Webhook notifications are HMAC-signed;
# set ADYEN_HMAC_KEY to the hex key from the Adyen Customer Area. We hold only
# Adyen stored-method tokens, never a PAN. Leave ADYEN_CHECKOUT_URL unset for test.
ADYEN_API_KEY=AQE_test_xxx
ADYEN_MERCHANT_ACCOUNT=YourMerchantAccount
ADYEN_MERCHANT_ID=mrc_xxx
ADYEN_HMAC_KEY=change_me_hex
# ADYEN_CHECKOUT_URL=https://{prefix}-checkout-live.adyenpayments.com/checkout/v71

# --- Braintree (POAL braintree adapter — DRIVE) ---
# Gateway keys; webhooks are signed (bt_signature/bt_payload) and verified with
# the private key. We hold only vault tokens, never a PAN.
BRAINTREE_MERCHANT_ID=your_bt_merchant_id
BRAINTREE_PUBLIC_KEY=bt_public_xxx
BRAINTREE_PRIVATE_KEY=bt_private_xxx
BRAINTREE_ENVIRONMENT=sandbox
BRAINTREE_AX10M_MERCHANT_ID=mrc_xxx

# --- GoCardless (POAL gocardless adapter — CO-DRIVE, bank debit) ---
# Access token + webhook secret. Webhooks are HMAC-SHA256-signed (Webhook-Signature
# header). The credential is a mandate (no card / no PAN). Leave Success+ on for
# co-drive, or create payments with retry_if_possible=false to fully drive.
GOCARDLESS_ACCESS_TOKEN=live_or_sandbox_token_xxx
GOCARDLESS_WEBHOOK_SECRET=change_me
GOCARDLESS_MERCHANT_ID=mrc_xxx
GOCARDLESS_ENVIRONMENT=sandbox

# --- Postgres (append-only, hash-chained ledger + OLTP) ---
DATABASE_URL=postgresql://ax10m:ax10m@localhost:5432/ax10m

# --- Redis (online features / cache) ---
REDIS_URL=redis://localhost:6379

# --- Temporal (durable recovery saga / charge scheduler) ---
# The worker (apps/api `run worker`) hosts the durable saga; the API dispatches to it.
# Start a local cluster with `docker compose -f docker-compose.temporal.yml up`.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=ax10m-recovery
# SAFETY GATE. Live charging is OFF by default — the worker runs in SHADOW mode
# (plans + measures, moves NO money). Set to "true" ONLY on a host with real
# processor credentials and an explicit intent to charge. See docs/RUNBOOK-WORKER.md.
AX10M_LIVE_CHARGING=false
# When "true", the HTTP API starts a durable Temporal workflow for treatment cases
# (instead of only planning inline). Requires a reachable Temporal cluster + a running
# worker. Non-fatal if the cluster is down (the API logs and falls back to inline).
AX10M_DURABLE_RECOVERY=false

# --- Feature pipeline ---
# Path to a JSON array of BIN ranges for real issuer/region/card signals. A PUBLIC
# network-brand starter table ships at ./data/bin-table.sample.json (brand only — region/
# issuer/cardType need a LICENSED BIN DB; see data/README.md). Unset → illustrative seed.
# AX10M_BIN_TABLE_PATH=./data/bin-table.sample.json

# --- Attribution engine ---
# Default control fraction for randomized holdout (0.10 = 10%).
AX10M_HOLDOUT_CONTROL_FRACTION=0.10
# Deterministic salt for holdout hashing. Rotate per environment; keep stable
# within an environment so assignment stays reproducible.
AX10M_HOLDOUT_SALT=change_me_stable_within_env
# Fee charged on the lower-bound verified uplift.
AX10M_FEE_RATE=0.12

# --- Dashboard (apps/dashboard) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
# Booking link for /schedule "Pick a time" (e.g. a Calendly URL). Unset → button disabled.
# NEXT_PUBLIC_SCHEDULER_URL=https://calendly.com/your-org/ax10m-demo

# --- LLM (comms + analytics ONLY — never the charge decision path) ---
# Set to enable LLM-personalized dunning copy via a real Anthropic client. Unset → the
# deterministic template agent (no key, no network). Every LLM message is validated (no PAN,
# must carry the update link + opt-out) and falls back to the template on anything off.
# ANTHROPIC_API_KEY=sk-ant-xxx
# Optional model override (default: a fast model suited to short transactional copy).
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Optional house-style guidance injected into the dunning system prompt.
# AX10M_COMMS_BRAND_VOICE=Warm, concise, no fake urgency.

# --- Dunning comms composition (OPT-IN; composes copy into the comms.sent ledger, does NOT send) ---
# Where the customer updates their card. Supports {invoiceId} / {customerId} placeholders.
# Composition turns on only when BOTH this and the opt-out below are set.
# AX10M_CARD_UPDATE_URL=https://billing.your-merchant.com/update-card?inv={invoiceId}
# How the customer opts out (unsubscribe link for email / "Reply STOP" for SMS). Required.
# AX10M_COMMS_OPT_OUT=Unsubscribe: https://your-merchant.com/unsubscribe
# Channel to compose for: email (default) or sms.
# AX10M_COMMS_CHANNEL=email
# Optional display name (falls back to the merchant id).
# AX10M_MERCHANT_NAME=Your Merchant
